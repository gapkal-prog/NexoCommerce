<?xml version="1.0"?>
<ruleset name="NexoCommerce">
    <description>PHP_CodeSniffer rules for NexoCommerce monorepo.</description>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg value="sp"/>

    <file>plugins</file>
    <file>packages</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>

    <rule ref="WordPress-Core"/>
    <rule ref="WordPress-Docs"/>
    <rule ref="WordPress-Extra"/>
    <rule ref="PHPCompatibilityWP">
        <properties>
            <property name="testVersion" value="8.0-"/>
        </properties>
    </rule>
</ruleset>
